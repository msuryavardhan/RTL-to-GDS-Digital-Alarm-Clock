# ============================================================
# Cadence Xcelium/Incisive simulator work-library cache
# (binary, host/version-locked; regenerated by re-running simulation)
# ============================================================
INCA_libs/
.simvision/
waves.shm/
*.diag

# ============================================================
# Cadence Innovus internal design-database directories
# (large binary checkpoints tied to a specific tool version/license;
#  the reviewable outputs — netlist, SPEF, GDS, SDC, reports, images —
#  are committed separately and do not require these)
# ============================================================
*.enc.dat/
*.enc[0-9]*.dat/

# ============================================================
# Verbose Cadence Innovus debug logs (very large, low signal-to-noise).
# The regular .log/.log1 and .cmd/.cmd1 command transcripts are kept.
# ============================================================
*.logv
*.logv1
*.logv2

# ============================================================
# NCLaunch / ncsim auto-generated session & command-history caches
# ============================================================
.nclaunch.dd
.nclaunch.dd.bak
nclaunch.key
ncsim.key

# ============================================================
# OS / editor cruft
# ============================================================
.DS_Store
Thumbs.db
